Constant Story "The Goddess in the Cellar";
Constant Headline "^A Lovecraftian tale of portals and sacrifice^";
Constant IFID "8ba9c0d1-e2f3-4456-9a7b-c8d9e0f1a2b3";
Serial "240916";
Release 2;
Constant MAX_SCORE 80;

Include "Parser";
Include "VerbLib";

Global goddess_appeased;
Global flower_eaten;
Global coin_pried;

[ Initialise;
    location = Cottage;
    move grandfather_clock to Cellar;
    move lantern to Cottage;
    move notebook to Cottage;
    move flower to ornate_box;
    "You are a stranger in a strange land.^^In the wilderness you find yourself before an ancient and foreboding structure, seeking refuge from forces you dare not name.^^Type 'help' for instructions.";
];

! ============================================================
! Rooms and their contents
! ============================================================

[ HearthstoneReveal;
    if (parent(rusty_key) == nothing) {
        move rusty_key to Cottage;
        "You lever the loose hearthstone aside, revealing a rusty iron key hidden in the gap beneath.";
    }
    "You shift the loose hearthstone, but there is nothing else beneath it.";
];

Object Cottage "Neolithic Cottage"
    with description
        "You stand within a decaying dwelling of cyclopean stonework. The hearth contains a fire that flickers with an unnatural, sickly hue, casting grotesque shadows upon the walls. A wooden door to the north leads to a garden, while a stone staircase descends into claustrophobic darkness below.",
    n_to Garden,
    d_to Cellar,
    has light;

Object -> hearthstone "loose hearthstone"
    with name 'hearthstone' 'hearthstones' 'stone' 'stones' 'loose' 'hearth' 'flagstone',
    description [;
        if (parent(rusty_key) == nothing) {
            move rusty_key to Cottage;
            "One of the hearthstones sits slightly askew, its mortar crumbled to dust. As you peer into the gap beneath, something metallic catches the sickly light -- a key, hidden there long ago.";
        }
        if (rusty_key in Cottage)
            "The loose hearthstone sits askew, the gap beneath it exposed. The key lies within reach.";
        "The loose hearthstone sits slightly askew, its gap empty now.";
    ],
    initial "One of the hearthstones around the hearth sits slightly askew, its mortar crumbled to dust.",
    before [;
        Take: return HearthstoneReveal();
        Remove: return HearthstoneReveal();
        Push: return HearthstoneReveal();
        Pull: return HearthstoneReveal();
        LookUnder:
            if (parent(rusty_key) == nothing) {
                move rusty_key to Cottage;
                "Beneath the loose hearthstone, something metallic catches the sickly light -- a key, hidden there long ago.";
            }
            "There is nothing beneath the loose hearthstone now but dust.";
    ],
    has static;

Object rusty_key "rusty key"
    with name 'rusty' 'key' 'iron',
    description "An iron key of unknown provenance, its surface pitted and marred by what may be ancient runes or merely the ravages of untold centuries. It feels unnaturally cold to the touch.",
    initial "A rusty key lies in the gap beneath the loose hearthstone.",
    has scored;

Object lantern "brass lantern"
    with name 'brass' 'lantern' 'lamp' 'antique',
    description "A brass lantern of antique and suspicious design. Its glass is stained with what might be soot -- or something far less innocuous.",
    initial "A tarnished brass lantern rests upon a shelf, its presence suggesting it has witnessed things no mortal eye should behold.",
    after [;
        SwitchOn: give self light; "The lantern sputters aloud with a sound like a dying breath, then emits a pallid, flickering light that seems to recoil from the corners of the room.";
        SwitchOff: give self ~light; "The light expires with a whispered hiss, as though the darkness itself had drawn its final breath.";
    ],
    has switchable;

Object notebook "tattered notebook"
    with name 'tattered' 'notebook' 'book' 'journal' 'diary' 'leather',
    description "A small notebook bound in cracked leather, its pages yellowed and spotted with mildew. The hand that penned these words trembled, the ink faded and blotched, yet four passages remain legible. The first, dated in a scrawled hand: 'She demands a sacrifice of gold, or she will cross into our world and consume it whole.' The second, written in a steady, educated hand: 'Eat the blue flower before you enter her realm. Its nectar will shield your lungs from the air of that place.' The third, hastily scrawled in a shaking hand: 'The stones form a ring. Enter from the south, go east or west around, and seek the gap to the north. Map it if you would not be lost.' The fourth, in a cramped, furtive hand: 'I will hide the key.'",
    initial "A tattered notebook lies upon the floor, its pages curled and stained.",
    has scored;

Object Garden "Garden"
    with description
        "You tread upon a garden long abandoned to forces beyond mortal comprehension. The stone path is cracked and uneven, as if rejected by some non-Euclidean geometry. To the south lies the ancient cottage, and to the east, a forest of twisted trees.",
    s_to Cottage,
    e_to Forest,
    has light scored;

Object Forest "Dark Forest"
    with description
        "You stand amidst a forest of gnarled and twisted trees that seem to drink the very light from the air. The trunks bear deep furrows, as though clawed by some monstrous hand in ages past. To the north, a faint path leads through the undergrowth toward a clearing.",
    w_to Garden,
    n_to StoneCircle,
    has light scored;

Object -> twig "twig"
    with name 'twig' 'stick' 'branch' 'wood' 'splinter',
    description "A slender twig, snapped from some nearby tree. Its bark is gnarled and darkened, as though the wood itself remembers the twisted forest to the east.",
    initial "A twig lies among the gnarled roots, pale against the dark soil.",
    before [;
        Insert:
            if (second == crack) {
                noun = coin;
                second = twig;
                return PrySub();
            }
    ],
    has scored;

Object StoneCircle "Stone Circle"
    with description
        "In a clearing amidst the twisted trees stands a ring of weathered menhirs, their surfaces carved with symbols that predate human memory. The stones hum faintly with a resonance felt more in the bones than the ears. To the north, a narrow gap between the menhirs leads into a labyrinth of stone. The forest stretches southward.",
    s_to Forest,
    n_to [;
        print "You squeeze through a narrow gap between two menhirs, the cold stone scraping against your shoulders, and find yourself threading through the labyrinth of standing stones.^";
        return LabyrinthSouth;
    ],
    has light;

Object LabyrinthSouth "Labyrinth South"
    with description
        "You stand in a narrow gap between massive menhirs, their carved surfaces cold and slick with lichen. The way south opens back to the clearing. To the east and west, further gaps lead deeper into the ring of stones. To the north, the menhirs stand flush, allowing no passage.",
    s_to StoneCircle,
    e_to LabyrinthEast,
    w_to LabyrinthWest,
    has light;

Object LabyrinthEast "Labyrinth East"
    with description
        "You edge along a passage between looming stones. Gaps lead north and south along the ring. To the east, a narrow crevice beckons -- perhaps a way through, or perhaps a trap. The stones to the west are unbroken, their carvings spiralling into patterns that hurt the eye.",
    s_to LabyrinthSouth,
    n_to LabyrinthNorth,
    e_to LabyrinthBlind,
    has light;

Object LabyrinthBlind "Blind Alley"
    with description
        "The crevice narrows to nothing. You stand in a pocket of cold stone, hemmed in on all sides by menhirs older than memory. The humming is louder here, almost a drone. There is nothing but stone and the echo of your own breath. The only way back is west.",
    w_to LabyrinthEast,
    has light;

Object LabyrinthNorth "Labyrinth North"
    with description
        "You push through a gap and emerge on the far side of the ring. The air feels charged with an ancient anticipation. To the north, a wider opening leads inward, toward the heart of the circle. Passages lead east and west along the ring. The way south is blocked by stones set too close to pass.",
    e_to LabyrinthEast,
    w_to LabyrinthWest,
    n_to AltarChamber,
    has light;

Object LabyrinthWest "Labyrinth West"
    with description
        "You thread between menhirs on the western arc of the ring. Their surfaces bear spiralling carvings that seem to shift at the edge of vision. A gap to the north leads onward, and to the east a passage returns toward the clearing. The stones to the south are impenetrable.",
    n_to LabyrinthNorth,
    e_to LabyrinthSouth,
    has light;

Object AltarChamber "Altar Chamber"
    with description
        "You push through the final gap and emerge at the heart of the stone circle. The menhirs ring you on all sides, their carvings converging inward toward this point. The air hums with a resonance that sets your teeth on edge. The only way out is south, back through the labyrinth.",
    s_to LabyrinthNorth,
    has light;

Object -> altar "stone altar"
    with name 'stone' 'altar' 'sacrificial' 'slab',
    description "A slab of dark stone, its surface worn smooth by countless hands -- or claws -- over millennia. Dark stains, long since dried to black, mark channels cut into the stone to drain what was once placed upon it. Faint carvings spiral inward toward a shallow basin at the centre.",
    initial "At the centre of the circle stands a stone altar, its surface darkened by ages of use -- or sacrifice.",
    has static;

Object -> ornate_box "ornate box"
    with name 'ornate' 'box' 'chest' 'carved' 'wooden',
    description "A small wooden box of exquisite craftsmanship, its surface carved with intricate, swirling patterns that seem to shift when not looked at directly. The patterns form shapes that hurt to comprehend -- angles that should not exist, spirals that curve into impossible directions.",
    initial "An ornate wooden box sits atop the altar, its craftsmanship eerily at odds with the crude stone around it.",
    with_key rusty_key,
    has lockable locked container openable;

Object flower "blue flower"
    with name 'blue' 'flower' 'blossom' 'bloom',
    description "A single bloated flower of an unnatural violet hue, its petals glistening with a viscous sheen. Its fragrance is cloying, almost narcotic, and you feel a creeping unease merely gazing upon it.",
    after [;
        Eat:
            flower_eaten = true;
            score = score + 10;
            "You bite into the bloom, and its viscous nectar floods your mouth with a taste at once sweet and profoundly wrong -- a flavor that seems to resonate in chambers of your mind that were never meant to awakened.";
    ],
    has edible scored;

Object Cellar "Dusty Cellar"
    with description
        "The cellar yawns before you, a cavern of damp stone and creeping shadow. The air is thick with the scent of mildew and something older, something that stirs memories best left buried. Cracks in the walls seem to weep a phosphorescent fluid. At the far end, a grandfather clock looms out of the darkness.",
    u_to Cottage,
    has scored;

Object -> grandfather_clock "grandfather clock"
    with name 'grandfather' 'clock' 'tall' 'wooden' 'pendulum',
    description "A massive grandfather clock of blackened wood, its face bearing no numbers -- only shifting, non-Euclidean symbols that seem to rearrange themselves when viewed from the corner of your eye. It ticks steadily, each beat accompanied by a sound like a distant scream.",
    initial "A grandfather clock of uncanny proportions stands against the far wall, its ticking echoing with a sound that seems to come from within your own skull.",
    before [;
        Enter: 
            if (parent(grandfather_clock) == Cellar) {
                move grandfather_clock to AlienWorld;
                print "As you step inside the clock, reality fractures around you. The clock's interior twists unnaturally through dimensions beyond mortal comprehension, and suddenly you find yourself standing upon an alien world beneath an impossible sky.^";
                PlayerTo(AlienWorld, 2);
                if (~~flower_eaten) {
                    deadflag = 1;
                    "^The air of this alien world is no air at all. Your first breath sears your lungs like vitriol, and what floods them is something for which your body was never wrought -- a toxin that burns and suffocates in equal measure. Your final thought is one of regret.^";
                }
                rtrue;
            }
            else if (parent(grandfather_clock) == AlienWorld) {
                move grandfather_clock to Cellar;
                print "As you step inside the clock, the fabric of space inverts upon itself. The clock's interior writhes unnaturally, and suddenly you are back in the familiar darkness of the cellar.^";
                PlayerTo(Cellar, 2);
                if (goddess_appeased) {
                    deadflag = 2;
                    score = score + 10;
                    "^You stumble from the clock into the reeking darkness of the cellar, and the alien weight upon your soul lifts at last. The clock's ticking slows, then stills, and when you look back at the clock, it too has gone cold. You have won the game.^";
                }
                rtrue;
            }
            else {
                "You step inside the clock, but nothing unusual happens.";
            }
    ],
    has enterable container;

Object -> crack "dark crack"
    with name 'crack' 'fissure' 'gap' 'crevice' 'floor',
    description [;
        if (parent(coin) == nothing) {
            move coin to Cellar;
            "A jagged fissure splits the flagstones, plunging into darkness. As you peer into its depths, something catches the pale light -- a gold coin, wedged deep within the crack, beyond the reach of your fingers.";
        }
        if (coin_pried)
            "A jagged fissure splits the flagstones, plunging into darkness. The gold coin lies loose at the bottom, ready to be taken.";
        if (coin in Cellar)
            "A jagged fissure splits the flagstones, plunging into darkness. The gold coin glints deep within, wedged beyond the reach of your fingers.";
        "A jagged fissure splits the flagstones, plunging into darkness. Nothing remains within.";
    ],
    initial "A jagged crack splits the stone floor, its depths lost to shadow.",
    has static;

Object AlienWorld "Alien World"
    with description
        "You stand upon a landscape of cyclopean stone spires that pierce a violet sky swirling with unnameable constellations. The very geometry of this place is wrong, angles folding in upon themselves in ways that make your head ache. To the south, a towering figure wreathed in blue flame regards you with eyes that contain infinities.",
    has light scored;

Object -> AlienHorror "indescribable horror"
    with name 'horror' 'thing' 'shape' 'monstrosity',
    description "It is merciful that your mind cannot fully comprehend what you see. The thing shifts and writhes with a motion that defies all laws of physics, its form existing simultaneously in more dimensions than your mind can process.",
    initial "Something moves at the edge of vision, a shape that should not exist.",
    found_in AlienWorld,
    has;

Object -> FlamingGoddess "flaming goddess"
    with name 'flaming' 'goddess' 'statue' 'idol' 'figure' 'effigy' 'obsidian' 'blue' 'flame' 'flames',
    description "A towering effigy, thrice the height of a man, wrought from some unknown obsidian stone whose surface drinks the light around it. Across that void-black surface crawl flames of a blue so intense it seems to freeze rather than burn. The figure's face is a mask of alien majesty and hunger.",
    initial "A towering flaming goddess looms nearby, its eerie blue flames casting grotesque shadows across the alien soil.",
    react_before [;
        if (goddess_appeased) rfalse;
        if (action == ##Give && noun == coin && second == self) rfalse;
        deadflag = 1;
        "The goddess's hollow eyes blaze with terrible azure light. Without warning, a bolt of cold blue fire arcs from her outstretched, too-many limbs and engulfs you utterly. Your final sensation is one of absolute, infinite cold.";
    ],
    life [;
        Give:
            if (noun == coin) {
                goddess_appeased = true;
                remove coin;
                score = score + 20;
                "The goddess's hollow eyes flare with a sudden, blinding azure light -- the cold flames roar higher for a heartbeat, then subside. The coin is gone, swallowed whole by the fire that wreathed her. You sense her satisfaction.";
            }
            deadflag = 1;
            "The goddess's eyes flare with wrath at your paltry offering. A bolt of cold blue fire leaps from her limbs and engulfs you, and your essence unravels into the void.";
    ],
    has animate;

Object coin "gold coin"
    with name 'gold' 'coin' 'tarnished' 'disc',
    description "A coin of gold -- or what appears to be gold -- bearing strange glyphs that seem to writhe when viewed directly. The metal is unnaturally warm, as though freshly minted, yet you sense it is far older than the world itself.",
    initial "A gold coin glints deep within the crack, wedged beyond the reach of your fingers.",
    before [;
        Take, Remove:
            if (coin_pried == false)
                "The coin is wedged too deeply in the crack for your fingers to reach. You would need something thin and strong to pry it loose.";
    ],
    has scored;

! ============================================================
! Custom verbs
! ============================================================

[ HelpSub;
    print "^HOW TO PLAY INTERACTIVE FICTION^";
    print "Type short commands telling the game what you want to do, then press Enter. Most commands take the form VERB or VERB NOUN.^";
    print "^Useful commands:^";
    print "  LOOK                 describe your surroundings^";
    print "  EXAMINE THING        inspect an object (X THING also works)^";
    print "  TAKE THING           pick something up^";
    print "  DROP THING           put something down^";
    print "  INVENTORY             list what you are carrying^";
    print "  NORTH, SOUTH, EAST, WEST, UP, DOWN (or N, S, E, W, U, D)^";
    print "  OPEN, CLOSE, ENTER, READ, GIVE, and other everyday verbs^";
    print "  SAVE / RESTORE       save or resume your progress^";
    print "  UNDO                 take back your previous move^";
    print "  SCORE                 show your current score^";
    print "  QUIT                  leave the game^";
    print "^Explore carefully, examine unusual objects, and pay attention to descriptions. If a command is not understood, try a simpler verb or a different name for the object.^";
    "You can type HELP or INSTRUCTIONS at any time to see this message again.^";
];

[ InhaleSub;
    if (noun == 0) {
        "You draw in a breath, but the air tastes stale and somehow wrong, as though it has passed through lungs not entirely human.";
    }
    if (noun == flower) {
        "The flower's scent is sickly-sweet, thick with notes that seem to resonate in parts of your mind best left undisturbed. A faint buzzing fills your ears.";
    }
    if (noun == coin) {
        "The coin emits a faint, metallic odor -- like old blood mixed with something far more ancient and unnameable.";
    }
    "You inhale near ", (the) noun, ", and the air seems to thicken with unseen presences.";
];

Verb meta 'help' 'instructions'
    * -> Help;

Verb 'inhale'
    * noun -> Inhale
    * -> Inhale;

[ PrySub;
    if (noun ~= coin && noun ~= crack)
        "You can't pry that loose.";
    if (coin_pried)
        "The coin is already loose on the flagstones.";
    if (second ~= twig)
        "You would need something thin and strong -- a twig, perhaps -- to pry the coin loose.";
    if (parent(coin) == nothing)
        move coin to Cellar;
    coin_pried = true;
    give coin moved;
    "You work the twig into the fissure and lever it carefully. The coin shifts, teeters, and drops onto the flagstones at your feet.";
];

Include "Grammar";

Extend 'pry' first
    * noun 'with' held -> Pry
    * noun -> Pry;

Extend 'take' last
    * noun 'with' held -> Pry;

Extend 'get' last
    * noun 'with' held -> Pry;

Extend 'smell' replace
    * noun -> Inhale
    * -> Smell;
