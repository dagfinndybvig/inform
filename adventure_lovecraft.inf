Constant Story "The Goddess in the Cellar";
Constant Headline "^A Lovecraftian tale of portals and sacrifice^";
Constant IFID "8ba9c0d1-e2f3-4456-9a7b-c8d9e0f1a2b3";
Serial "240915";
Constant MAX_SCORE 76;

Include "Parser";
Include "VerbLib";

Global goddess_appeased;
Global flower_eaten;

[ Initialise;
    location = Cottage;
    move grandfather_clock to Cellar;
    move coin to Cellar;
    move rusty_key to Cottage;
    move lantern to Cottage;
    move notebook to Cottage;
    move flower to ornate_box;
    "Welcome to the Neolithic Cottage. You find yourself before an ancient and foreboding structure, seeking refuge from forces you dare not name.^^";
];

! ============================================================
! Rooms and their contents
! ============================================================

Object Cottage "Neolithic Cottage"
    with description
        "You stand within a decaying dwelling of cyclopean stonework. The hearth contains a fire that flickers with an unnatural, sickly hue, casting grotesque shadows upon the walls. A wooden door hangs askew upon its hinges, leading south toward a garden long abandoned. A wooden staircase descends into darkness to the north, and eastward, you glimpse the twisted boughs of a forest whose trees seem far too ancient to exist in any known world.",
    n_to Garden,
    d_to Cellar,
    has light;

Object rusty_key "rusty key"
    with name 'rusty' 'key' 'iron',
    description "An iron key of unknown provenance, its surface pitted and marred by what may be ancient runes or merely the ravages of untold centuries. It feels unnaturally cold to the touch.",
    initial "An iron key lies upon the floor, its purpose lost to the mists of time.",
    has scored;

Object lantern "brass lantern"
    with name 'brass' 'lantern' 'lamp' 'antique',
    description "A brass lantern of antique and suspicious design. Its glass is stained with what might be soot -- or something far less innocuous.",
    initial "A tarnished brass lantern rests upon a shelf, its presence suggesting it has witnessed things no mortal eye should behold.",
    after [;
        SwitchOn: give self light; "The lantern sputters aloud with a sound like a dying breath, then emits a pallid, flickering light that seems to recoil from the corners of the room.";
        SwitchOff: give self ~light; "The light expires with a whispered hiss, as though the darkness itself had drawn its final breath.";
    ],
    has switchable;

Object notebook "tattered notebook"
    with name 'tattered' 'notebook' 'book' 'journal' 'diary' 'leather',
    description "A small notebook bound in cracked leather, its pages yellowed and spotted with mildew. The hand that penned these words trembled, the ink faded and blotched, yet two passages remain legible: 'The flower grants asylum from the void,' and 'Only through sacrifice may one return.'",
    initial "A tattered notebook lies upon the floor, its pages curled and stained.",
    has scored;

Object Garden "Garden"
    with description
        "You tread upon a garden long abandoned to forces beyond mortal comprehension. The stone path is cracked and uneven, as if rejected by some non-Euclidean geometry. To the south lies the ancient dwelling, while eastward the forest beckons with its twisted boughs.",
    s_to Cottage,
    e_to Forest,
    has light scored;

Object Forest "Dark Forest"
    with description
        "You stand amidst a forest of gnarled and twisted trees that seem to drink the very light from the air. The trunks bear deep furrows, as though clawed by some monstrous hand in ages past. Beneath your feet, the earth is black and unnaturally warm. A path leads westward toward the garden.",
    w_to Garden,
    has light scored;

Object -> ornate_box "ornate box"
    with name 'ornate' 'box' 'chest' 'carved' 'wooden',
    description "A small wooden box of exquisite craftsmanship, its surface carved with intricate, swirling patterns that seem to shift when not looked at directly. The patterns form shapes that the eye cannot quite resolve, yet fill you with inexplicable dread.",
    initial "An ornate wooden box rests among the roots of a gnarled tree, its craftsmanship eerily at odds with the primitive forest around it.",
    with with_key rusty_key,
    has lockable locked container openable;

Object flower "blue flower"
    with name 'blue' 'flower' 'blossom' 'bloom',
    description "A single bloated flower of an unnatural violet hue, its petals glistening with a viscous sheen. Its fragrance is cloying, almost narcotic, and you feel a creeping unease merely gazing upon it.",
    after [;
        Eat:
            flower_eaten = true;
            score = score + 10;
            "You bite into the bloom, and its viscous nectar floods your mouth with a taste at once sweet and profoundly wrong -- a flavor that seems to resonate in chambers of your mind that were never meant to exist. As the juices slide down your throat, your lungs expand painfully, and the air around you becomes breathable once more.";
    ],
    has edible scored;

Object Cellar "Dusty Cellar"
    with description
        "The cellar yawns before you, a cavern of damp stone and creeping shadow. The air is thick with the scent of mildew and something older, something that stirs memories best left buried. Cracks spider-web the stone walls, and in places, stone has crumbled to reveal a deeper darkness beneath. A wooden staircase leads upward.",
    u_to Cottage,
    has scored;

Object -> grandfather_clock "grandfather clock"
    with name 'grandfather' 'clock' 'tall' 'wooden' 'pendulum',
    description "A massive grandfather clock of blackened wood, its face bearing no numbers -- only shifting, non-Euclidean symbols that seem to rearrange themselves when viewed from the corner of your eye. Its pendulum swings with a rhythm that does not match the ticking of its mechanism.",
    initial "A grandfather clock of uncanny proportions stands against the far wall, its ticking echoing with a sound that seems to come from within your own skull.",
    before [;
        Enter: 
            if (parent(grandfather_clock) == Cellar) {
                move grandfather_clock to AlienWorld;
                print "As you step inside the clock, reality fractures around you. The clock's interior twists unnaturally through dimensions beyond mortal comprehension, and suddenly you find yourself standing upon alien soil beneath a violet sky.^";
                PlayerTo(AlienWorld, 2);
                if (~~flower_eaten) {
                    deadflag = 1;
                    "^The air of this alien world is no air at all. Your first breath sears your lungs like vitriol, and what floods them is something for which your body was never wrought -- a thick, burning substance that dissolves your consciousness into screaming void.";
                }
                rtrue;
            }
            else if (parent(grandfather_clock) == AlienWorld) {
                move grandfather_clock to Cellar;
                print "As you step inside the clock, the fabric of space inverts upon itself. The clock's interior writhes unnaturally, and suddenly you are back in the familiar darkness of the cellar.^";
                PlayerTo(Cellar, 2);
                if (goddess_appeased) {
                    deadflag = 2;
                    score = score + 10;
                    "^You stumble from the clock into the reeking darkness of the cellar, and the alien weight upon your soul lifts at last. The clock's ticking slows, then stills, and when you look back, it appears to be merely a normal piece of furniture. You have survived your ordeal and returned home.";
                }
                rtrue;
            }
            else {
                "You step inside the clock, but nothing unusual happens.";
            }
    ],
    has enterable container;

Object AlienWorld "Alien World"
    with description
        "You stand upon a landscape of cyclopean stone spires that pierce a violet sky swirling with unnameable constellations. The very geometry of this place is wrong, angles folding in upon themselves, horizons that descend as easily as they rise. The air burns with each breath. Before you looms a towering effigy, wrought of obsidian and wrapped in flames of an impossible blue.",
    has light scored;

Object -> AlienHorror "indescribable horror"
    with name 'horror' 'thing' 'shape' 'monstrosity',
    description "It is merciful that your mind cannot fully comprehend what you see. The thing shifts and writhes with a motion that defies all laws of physics, its form existing simultaneously in multiple angles of approach, as though folded through dimensions that your eyes were not designed to perceive.",
    initial "Something moves at the edge of vision, a shape that should not exist.",
    found_in AlienWorld,
    has;

Object -> FlamingGoddess "flaming goddess"
    with name 'flaming' 'goddess' 'statue' 'idol' 'figure' 'effigy' 'obsidian' 'blue' 'flame' 'flames',
    description "A towering effigy, thrice the height of a man, wrought from some unknown obsidian stone whose surface drinks the light around it. Across that void-black surface crawl flames of an impossible blue, dancing with a terrible, almost sentient, intelligence. The figure's hollow eyes burn with a light that speaks only of hunger and ancient malice.",
    initial "A towering flaming goddess looms nearby, its eerie blue flames casting grotesque shadows across the alien soil.",
    react_before [;
        if (goddess_appeased) rfalse;
        if (action == ##Give && noun == coin && second == self) rfalse;
        deadflag = 1;
        "The goddess's hollow eyes blaze with terrible azure light. Without warning, a bolt of cold blue fire arcs from her outstretched, too-many limbs and engulfs you utterly. Your final sensation is one of burning cold as your essence unravels into the void.";
    ],
    life [;
        Give:
            if (noun == coin) {
                goddess_appeased = true;
                remove coin;
                score = score + 20;
                "The goddess's hollow eyes flare with a sudden, blinding azure light -- the cold flames roar higher for a heartbeat, then subside. The coin is gone, swallowed whole by the fire that wraps her form. The goddess, it seems, is satisfied.";
            }
            deadflag = 1;
            "The goddess's eyes flare with wrath at your paltry offering. A bolt of cold blue fire leaps from her limbs and engulfs you, and your essence unravels into the void.";
    ],
    has animate;

Object coin "gold coin"
    with name 'gold' 'coin' 'tarnished' 'disc',
    description "A coin of gold -- or what appears to be gold -- bearing strange glyphs that seem to writhe when viewed directly. The metal is unnaturally warm, as though freshly minted, yet you sense it has existed since before time took its current form.",
    initial "Something glints in the dust: a coin of dubious origin, its very presence filling you with a creeping disquiet.",
    has scored;

! ============================================================
! A simple custom verb
! ============================================================

[ InhaleSub;
    if (noun == 0) {
        "You draw in a breath, but the air tastes stale and somehow wrong, as though it has passed through lungs not entirely human.";
    }
    if (noun == flower) {
        "The flower's scent is sickly-sweet, thick with notes that seem to resonate in parts of your mind best left undisturbed. A faint buzzing fills your ears.";
    }
    if (noun == coin) {
        "The coin emits a faint, metallic odor -- like old blood mixed with something far more ancient and unnameable.";
    }
    "You inhale near ", (the) noun, ", and the air seems to thicken with unseen presences.";
];

Verb 'inhale'
    * noun -> Inhale
    * -> Inhale;

Include "Grammar";

Extend 'smell' replace
    * noun -> Inhale
    * -> Smell;
